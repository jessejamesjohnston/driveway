<?xml version="1.0" encoding="utf-8"?>
<!-- Figtree (SIL Open Font License 1.1), the Merriment Labs text face: one
     variable font file, named at the four weights Driveway uses. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
  <font android:font="@font/figtree_variable" android:fontStyle="normal" android:fontWeight="400"
      android:fontVariationSettings="'wght' 400" />
  <font android:font="@font/figtree_variable" android:fontStyle="normal" android:fontWeight="500"
      android:fontVariationSettings="'wght' 500" />
  <font android:font="@font/figtree_variable" android:fontStyle="normal" android:fontWeight="600"
      android:fontVariationSettings="'wght' 600" />
  <font android:font="@font/figtree_variable" android:fontStyle="normal" android:fontWeight="700"
      android:fontVariationSettings="'wght' 700" />
</font-family>
