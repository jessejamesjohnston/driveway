<?xml version="1.0" encoding="utf-8"?>
<!-- Driveway's own colors (the Merriment Labs app DNA): a quiet green-gray
     page, near-white cards, Driveway green as the one accent. Contrast is
     measured on the rendered screens (docs/LARGE-SCREEN-A11Y.md). -->
<resources>
  <color name="icon_background">#FF2F6F5E</color>
  <color name="page">#FFEEF3F0</color>
  <color name="card">#FFFBFDFC</color>
  <color name="ink">#FF17201C</color>
  <color name="muted">#FF4F5D57</color>
  <!-- Hairlines between rows, and a field's outline (3:1 on the card). -->
  <color name="line">#1F17201C</color>
  <color name="outline">#FF73817B</color>
  <color name="accent">#FF2F6F5E</color>
  <color name="on_accent">#FFFFFFFF</color>
  <!-- Tonal buttons and icon tiles. -->
  <color name="accent_container">#FFD5EAE2</color>
  <color name="on_accent_container">#FF1D4B3E</color>
  <!-- A save waiting: amber. Identity changed or sign-in ended: red. -->
  <color name="attention_bg">#FFFFF1D6</color>
  <color name="attention_ink">#FF6E4600</color>
  <color name="trust_bg">#FFFBE3DE</color>
  <color name="trust_ink">#FF8E271B</color>
</resources>
